# ---- Spatial Agent Studio MVP ----
# Copy to .env and fill in real values. Never commit .env.

# HTTP
PORT=7440
APP_ORIGIN=http://127.0.0.1:5174
# Comma-separated extra origins (e.g. Cloudflare Pages preview)
CORS_ORIGINS=
COOKIE_SECURE=false
NODE_ENV=development

# PostgreSQL (dedicated app role / database created by scripts/db.ts bootstrap)
DATABASE_URL=postgresql://sas_app:CHANGE_ME@127.0.0.1:5432/spatial_agent_studio
TEST_DATABASE_URL=postgresql://sas_app:CHANGE_ME@127.0.0.1:5432/spatial_agent_studio_test

# Session
SESSION_TTL_HOURS=8

# Web build: set only when the SPA is hosted on a different origin (Cloudflare Pages)
# VITE_API_BASE_URL=https://sas-api.example.com

# Seeded demo users (password is hashed at seed time; change before sharing)
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=CHANGE_ME_MANAGER
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=CHANGE_ME_STAFF
