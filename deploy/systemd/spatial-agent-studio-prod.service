[Unit]
Description=Spatial Agent Studio Production API (port 7460)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kensan/Projects/Business-Project/Spatial-Agent-Studio

# 0600 の本番専用 env。**EnvironmentFile は下の Environment= より優先される**ため、
# PORT/DB/CORS は env 側に置かず、ここ（unit）だけで指定する。
EnvironmentFile=-%h/.config/spatial-agent-studio/prod-api.env

Environment=NODE_ENV=production
Environment=PORT=7460
Environment=HOST=127.0.0.1
Environment=COOKIE_SECURE=true
Environment=APP_ORIGIN=https://spatial-agent-studio.mirai-dx-platform.com
Environment=CORS_ORIGINS=https://spatial-agent-studio.mirai-dx-platform.com
Environment=DATABASE_URL=postgresql:///spatial_agent_studio_prod?host=/var/run/postgresql
# 本番の認証ハードニング（2026-11-20 の本番QA指摘に対応）
# - デモアカウントのパスワードログインを禁止
# - /api/auth/* は Origin ヘッダ必須（Originなしの機械的アクセスを拒否）
# - Accessメールを本文から受け取る方式は無効（Access未検証で任意メールになりすませるため）
Environment=SAS_DEMO_LOGIN=false
Environment=SAS_REQUIRE_ORIGIN_AUTH=true
Environment=SAS_ACCESS_EMAIL_LOGIN=false
# Access JWT 検証（本番の正規ログイン経路）。Tunnel 経由で Access 配下に置くこと。
Environment=SAS_REQUIRE_ACCESS_JWT=true
Environment=SAS_ACCESS_TEAM_DOMAIN=https://winter-lake-f4c9.cloudflareaccess.com
Environment=SAS_ACCESS_AUD=d62ec50f26efc45295acff076d5b533483c6b3912aa2159a7f2129b406ef78b1

ExecStart=/home/kensan/Projects/Business-Project/Spatial-Agent-Studio/node_modules/.bin/tsx src/api/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
