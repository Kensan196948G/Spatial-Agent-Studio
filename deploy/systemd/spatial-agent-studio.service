[Unit]
Description=Spatial Agent Studio MVP API (local preview)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kensan/Projects/Business-Project/Spatial-Agent-Studio

# 0600 の env ファイル（git管理外）。CORS_ORIGINS・DATABASE_URL・
# Cloudflare Access のロール割当（SAS_ACCESS_ROLES_FILE）を含む。
# 例: ~/.config/spatial-agent-studio/preview-api.env
EnvironmentFile=-%h/.config/spatial-agent-studio/preview-api.env

# 明示値は env ファイルより優先される
Environment=NODE_ENV=production
Environment=PORT=7450
Environment=HOST=127.0.0.1
Environment=COOKIE_SECURE=true
Environment=APP_ORIGIN=https://spatial-agent-studio-preview.pages.dev
Environment=CORS_ORIGINS=https://spatial-agent-studio-preview.pages.dev,https://spatial-agent-studio-preview.mirai-dx-platform.com,https://spatial-agent-studio.pages.dev,https://spatial-agent-studio.mirai-dx-platform.com
Environment=DATABASE_URL=postgresql:///spatial_agent_studio_preview?host=/var/run/postgresql

ExecStart=/home/kensan/Projects/Business-Project/Spatial-Agent-Studio/node_modules/.bin/tsx src/api/server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
